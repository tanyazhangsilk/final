# MySQL（与 README 一致；由 app/core/config.py 加载）
# 请把 MYSQL_PASSWORD 改成你本机 MySQL 的实际密码。
# 库名不要用连字符（不要用 E-charge）；与下面 MYSQL_DB 一致先建库：
#   CREATE DATABASE echarge CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# 密码须与你在「mysql -u root -p」里输入的一致。
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=echarge
